# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file - it is listed in .gitignore.

# Which AI provider to use: "gemini" (free tier, no card needed) or "openai" (paid)
LLM_PROVIDER=gemini

# --- Gemini (default). Free key: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (only needed if LLM_PROVIDER=openai). Key: https://platform.openai.com/api-keys ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning (defaults shown)
# MAX_HISTORY_MESSAGES=12
# SESSION_TTL_MINUTES=60
# RAG_TOP_K=4
# RAG_SIMILARITY_CUTOFF=0.2
# RATE_LIMIT_PER_MINUTE=20
# LOG_LEVEL=INFO
